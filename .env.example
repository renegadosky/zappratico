# ============================================================
# ZapPrático — variáveis de ambiente
# Copie para .env  (cp .env.example .env)  e preencha.
# ============================================================

# --- Supabase (crie um projeto em https://supabase.com) -----
# Settings > API. As VITE_* vão para o navegador (chave pública/anon).
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...anon-key...
# Mesmos valores para o servidor:
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJ...anon-key...
# NUNCA exponha esta chave no front-end (service_role):
SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role-key...

# --- IA (qualquer provedor compatível com OpenAI) ----------
# Padrão: Google Gemini (plano gratuito em https://aistudio.google.com/apikey)
AI_API_KEY=
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-2.5-flash

# --- Stripe (assinaturas dos planos Pro/Business) ----------
# Opcional: sem isso o app funciona, só a página de planos/assinatura fica inativa.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- WhatsApp Cloud API (Meta) -----------------------------
# "App Secret" do app Meta — valida a assinatura dos webhooks recebidos.
WHATSAPP_APP_SECRET=
